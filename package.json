{
  "name": "qing-yichu",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fetch:bg-removal": "node scripts/fetch-bg-removal.mjs",
    "build:web": "npm run fetch:bg-removal && tsc -b && vite build",
    "build:native": "npm run fetch:bg-removal && VITE_BASE=/ npx tsc -b && VITE_BASE=/ npx vite build",
    "cap:sync": "npx cap sync android",
    "android:sync": "npm run build:native && npx cap sync android",
    "android:open": "npx cap open android",
    "verify:bg-removal": "node scripts/verify-capacitor-bg-removal.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@imgly/background-removal": "^1.7.0",
    "idb": "^8.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
